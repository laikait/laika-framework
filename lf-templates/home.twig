<!DOCTYPE html>
<html lang="{{ local }}">
<head>
    <meta charset="UTF-8">
    <title>{{ title }} - Laika Framework</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- Favicon -->
    <link href="{{ 'asset.src' | hook('assets/img/icon.png') }}" rel="icon" sizes="32x32">

    {{ 'print.header' | hook }}
</head>
<body>
    <div class="container">
        <img class="logo" src={{ 'asset.src' | hook('assets/img/logo.png') }}>
        <h1>{{ welcome }}</h1>
        <p>Your Lightweight MMC Framework for Fast and Clean Development.</p>
        <a class="docs-link" href="{{ provider.docurl }}">Read the Docs</a>
        <div class="footer">
            <div class="copyright">&copy; : {{ '' | date('Y') }}</div>
        <div>
    </div>
    {{ 'print.footer' | hook }}
</body>
</html>

