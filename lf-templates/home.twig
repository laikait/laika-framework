<!DOCTYPE html>
<html lang="{{ local }}">
<head>
    <meta charset="UTF-8">
    <title>{{ title }} - Laika Framework</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- Favicon -->
    <link href="{{ 'app_asset' | hook('img/icon.png') }}" rel="icon" sizes="32x32">

    {{ 'lf_header' | hook }}
</head>
<body>
    <div class="container">
        <img class="logo" src={{ 'app_asset' | hook('img/logo.png') }}>
        <h1>{{ welcome }}</h1>
        <p>PHP MVC Framework for Fast, Clean & Rest API Development.</p>
        <a class="docs-link" href="{{ provider.docurl }}">Read the Docs</a>
        <div class="footer">
            <div class="copyright">&copy; {{ '' | date('Y') }}. {{ 'app_name' | hook }}</div>
        <div>
    </div>
    {{ 'lf_footer' | hook }}
</body>
</html>

