{
    "name": "laikait/laika-framework",
    "description": "Laika PHP Micro Framework",
    "type": "project",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "App\\": "lf-app/"
        }
    },
    "authors": [
        {
            "name": "Laika IT",
            "email": "strblackhawk@gmail.com"
        },
        {
            "name": "Showket Ahmed",
            "email": "riyadhtayf@gmail.com"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "php": ">=8.1",
        "laikait/laika-core": "^4"
    },
    "config": {
        "allow-plugins": {
            "laikait/laika-cli": true,
            "laikait/laika-queue": true
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "php laika secret:fix --byte=32",
            "php laika app:sync"
        ]
    }
}
